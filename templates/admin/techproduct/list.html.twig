{% extends 'base.html.twig' %}

{% block title %}Tech Products - Symfony CMS Admin{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>Tech Products</span>
        {% if is_granted('ROLE_EDITOR') %}
            <a href="{{ path('admin_techproduct_create') }}" class="btn btn-primary">Add Tech Product</a>
        {% endif %}
    </div>

    {% if techProducts is empty %}
        <p style="text-align: center; padding: 3rem; color: #7f8c8d;">
            No tech products found. 
            {% if is_granted('ROLE_EDITOR') %}
                <a href="{{ path('admin_techproduct_create') }}" style="color: #3498db;">Add your first product</a>
            {% endif %}
        </p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Name</th>
                    <th>Specs</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in techProducts %}
                    <tr>
                        <td>
                            <code style="background: #f8f9fa; padding: 0.25rem 0.5rem; border-radius: 3px;">
                                {{ product.productId }}
                            </code>
                        </td>
                        <td><strong>{{ product.name }}</strong></td>
                        <td>
                            <details style="cursor: pointer;">
                                <summary style="color: #3498db;">View Specs</summary>
                                <pre style="background: #f8f9fa; padding: 0.5rem; border-radius: 4px; margin-top: 0.5rem; font-size: 0.875rem; overflow-x: auto;">{{ product.specs|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                            </details>
                        </td>
                        <td>{{ product.createdAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <div class="actions">
                                {% if is_granted('EDIT', product) %}
                                    <a href="{{ path('admin_techproduct_edit', {id: product.id}) }}" class="btn btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Edit</a>
                                {% endif %}
                                {% if is_granted('DELETE', product) %}
                                    <form method="post" action="{{ path('admin_techproduct_delete', {id: product.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this tech product?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-techproduct-' ~ product.id) }}">
                                        <button type="submit" class="btn btn-danger" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Delete</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if pages > 1 %}
            <div class="pagination">
                {% if page > 1 %}
                    <a href="{{ path('admin_techproduct_list', {page: page - 1}) }}">Previous</a>
                {% endif %}

                {% for p in 1..pages %}
                    {% if p == page %}
                        <span class="active">{{ p }}</span>
                    {% else %}
                        <a href="{{ path('admin_techproduct_list', {page: p}) }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}

                {% if page < pages %}
                    <a href="{{ path('admin_techproduct_list', {page: page + 1}) }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
