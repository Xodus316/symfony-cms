{% extends 'base.html.twig' %}

{% block title %}{{ techProduct.name }} - Symfony CMS Admin{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>{{ techProduct.name }}</span>
        <div class="actions">
            {% if is_granted('EDIT', techProduct) %}
                <a href="{{ path('admin_techproduct_edit', {id: techProduct.id}) }}" class="btn btn-primary" style="font-size: 0.875rem;">Edit</a>
            {% endif %}
            <a href="{{ path('admin_techproduct_list') }}" class="btn btn-secondary" style="font-size: 0.875rem;">Back to List</a>
        </div>
    </div>

    <div style="margin-bottom: 1.5rem; color: #7f8c8d; font-size: 0.875rem; display: flex; gap: 1.5rem; flex-wrap: wrap;">
        <span>Product ID: <code style="background: #f8f9fa; padding: 0.25rem 0.5rem; border-radius: 3px;">{{ techProduct.productId }}</code></span>
        <span>Created {{ techProduct.createdAt|date('Y-m-d H:i') }}</span>
        {% if techProduct.updatedAt %}
            <span>Updated {{ techProduct.updatedAt|date('Y-m-d H:i') }}</span>
        {% endif %}
    </div>

    {% if techProduct.pricing %}
        <div style="margin-bottom: 1.5rem;">
            <h3 style="margin-bottom: 0.5rem; color: #2c3e50;">Pricing</h3>
            <pre style="background: #f8f9fa; padding: 1rem; border-radius: 4px; font-size: 0.875rem; overflow-x: auto;">{{ techProduct.pricing|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </div>
    {% endif %}

    <div>
        <h3 style="margin-bottom: 0.5rem; color: #2c3e50;">Specifications</h3>
        <pre style="background: #f8f9fa; padding: 1rem; border-radius: 4px; font-size: 0.875rem; overflow-x: auto;">{{ techProduct.specs|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    </div>
</div>
{% endblock %}
