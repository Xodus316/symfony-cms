{% extends 'base.html.twig' %}

{% block title %}{{ user ? 'Edit User' : 'Create User' }} - Symfony CMS Admin{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">{{ user ? 'Edit User' : 'Create New User' }}</div>

    <form method="post">
        <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" value="{{ user ? user.email : '' }}" required>
        </div>

        <div class="form-group">
            <label for="password">Password {{ user ? '(leave empty to keep current)' : '*' }}</label>
            <input type="password" id="password" name="password" {{ user ? '' : 'required' }}>
            {% if not user %}
                <small style="color: #7f8c8d; font-size: 0.875rem;">Minimum 6 characters</small>
            {% endif %}
        </div>

        <div class="form-group">
            <label>Roles *</label>
            <div style="margin-top: 0.5rem;">
                <div style="margin-bottom: 0.75rem;">
                    <label style="font-weight: normal; display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                        <input type="checkbox" name="roles[]" value="ROLE_VIEWER" {{ user and 'ROLE_VIEWER' in user.roles ? 'checked' : '' }} style="width: 18px; height: 18px; cursor: pointer; flex-shrink: 0;">
                        <span class="badge badge-viewer" style="flex-shrink: 0;">VIEWER</span>
                        <span style="color: #7f8c8d; font-size: 0.875rem;">Can view content</span>
                    </label>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <label style="font-weight: normal; display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                        <input type="checkbox" name="roles[]" value="ROLE_EDITOR" {{ user and 'ROLE_EDITOR' in user.roles ? 'checked' : '' }} style="width: 18px; height: 18px; cursor: pointer; flex-shrink: 0;">
                        <span class="badge badge-editor" style="flex-shrink: 0;">EDITOR</span>
                        <span style="color: #7f8c8d; font-size: 0.875rem;">Can create and edit content (includes VIEWER)</span>
                    </label>
                </div>
                <div style="margin-bottom: 0.75rem;">
                    <label style="font-weight: normal; display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                        <input type="checkbox" name="roles[]" value="ROLE_ADMIN" {{ user and 'ROLE_ADMIN' in user.roles ? 'checked' : '' }} style="width: 18px; height: 18px; cursor: pointer; flex-shrink: 0;">
                        <span class="badge badge-admin" style="flex-shrink: 0;">ADMIN</span>
                        <span style="color: #7f8c8d; font-size: 0.875rem;">Full access including user management (includes EDITOR)</span>
                    </label>
                </div>
            </div>
            <small style="color: #7f8c8d; font-size: 0.875rem; display: block; margin-top: 0.5rem;">
                Note: Higher roles automatically include lower role permissions
            </small>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn btn-primary">{{ user ? 'Update' : 'Create' }} User</button>
            <a href="{{ path('admin_user_list') }}" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
