{% extends 'base.html.twig' %}

{% block title %}Articles - Symfony CMS Admin{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>Articles</span>
        {% if is_granted('ROLE_EDITOR') %}
            <a href="{{ path('admin_article_create') }}" class="btn btn-primary">Create New Article</a>
        {% endif %}
    </div>

    {% if articles is empty %}
        <p style="text-align: center; padding: 3rem; color: #7f8c8d;">
            No articles found. 
            {% if is_granted('ROLE_EDITOR') %}
                <a href="{{ path('admin_article_create') }}" style="color: #3498db;">Create your first article</a>
            {% endif %}
        </p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Author</th>
                    <th>Published</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.id }}</td>
                        <td>
                            <a href="{{ path('admin_article_show', {id: article.id}) }}" style="color: #2c3e50; text-decoration: none; font-weight: bold;">
                                {{ article.title }}
                            </a>
                        </td>
                        <td>
                            <code style="background: #f8f9fa; padding: 0.25rem 0.5rem; border-radius: 3px;">
                                {{ article.slug }}
                            </code>
                        </td>
                        <td>{{ article.author ?? article.user.email }}</td>
                        <td>
                            {% if article.publishDate %}
                                <span class="badge badge-published">{{ article.publishDate|date('Y-m-d') }}</span>
                            {% else %}
                                <span class="badge badge-draft">Draft</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if article.lockedBy %}
                                <span class="badge badge-locked" title="Locked at {{ article.lockedAt|date('Y-m-d H:i') }}">
                                    Locked by {{ article.lockedBy.email }}
                                </span>
                                {% if is_granted('ARTICLE_UNLOCK', article) %}
                                    <form method="post" action="{{ path('admin_article_unlock', {id: article.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('unlock-article-' ~ article.id) }}">
                                        <button type="submit" class="btn btn-secondary" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Unlock</button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td>{{ article.createdAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <div class="actions">
                                {% if is_granted('ARTICLE_EDIT', article) %}
                                    <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Edit</a>
                                {% endif %}
                                {% if is_granted('ARTICLE_DELETE', article) %}
                                    <form method="post" action="{{ path('admin_article_delete', {id: article.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this article?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-article-' ~ article.id) }}">
                                        <button type="submit" class="btn btn-danger" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Delete</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if pages > 1 %}
            <div class="pagination">
                {% if page > 1 %}
                    <a href="{{ path('admin_article_list', {page: page - 1}) }}">Previous</a>
                {% endif %}

                {% for p in 1..pages %}
                    {% if p == page %}
                        <span class="active">{{ p }}</span>
                    {% else %}
                        <a href="{{ path('admin_article_list', {page: p}) }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}

                {% if page < pages %}
                    <a href="{{ path('admin_article_list', {page: page + 1}) }}">Next</a>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
