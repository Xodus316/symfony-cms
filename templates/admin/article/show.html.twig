{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} - Symfony CMS Admin{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>{{ article.title }}</span>
        <div class="actions">
            {% if is_granted('ARTICLE_EDIT', article) %}
                <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-primary" style="font-size: 0.875rem;">Edit</a>
            {% endif %}
            <a href="{{ path('admin_article_list') }}" class="btn btn-secondary" style="font-size: 0.875rem;">Back to List</a>
        </div>
    </div>

    <div style="margin-bottom: 1.5rem; color: #7f8c8d; font-size: 0.875rem; display: flex; gap: 1.5rem; flex-wrap: wrap;">
        <span>By {{ article.author ?? article.user.email }}</span>
        <span>Created {{ article.createdAt|date('Y-m-d H:i') }}</span>
        {% if article.updatedAt %}
            <span>Updated {{ article.updatedAt|date('Y-m-d H:i') }}</span>
        {% endif %}
        {% if article.publishDate %}
            <span class="badge badge-published">Published {{ article.publishDate|date('Y-m-d') }}</span>
        {% else %}
            <span class="badge badge-draft">Draft</span>
        {% endif %}
        {% if article.lockedBy %}
            <span class="badge badge-locked">Locked by {{ article.lockedBy.email }}</span>
        {% endif %}
    </div>

    <div style="margin-bottom: 1.5rem;">
        <code style="background: #f8f9fa; padding: 0.25rem 0.5rem; border-radius: 3px; font-size: 0.875rem;">
            /{{ article.slug }}
        </code>
    </div>

    <div style="line-height: 1.8; white-space: pre-wrap;">{{ article.content }}</div>

    {% if techProducts is not empty %}
        <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 2px solid #ecf0f1;">
            <h3 style="margin-bottom: 1rem; color: #2c3e50;">Associated Tech Products</h3>
            <table>
                <thead>
                    <tr>
                        <th>Product ID</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in techProducts %}
                        <tr>
                            <td>{{ product.productId ?? product.id }}</td>
                            <td>{{ product.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
